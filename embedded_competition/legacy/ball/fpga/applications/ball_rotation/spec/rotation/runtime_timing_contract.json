          "default": 2100000,
          "description": "按键消抖"
        },
        {
          "name": "C_LONG_PRESS",
          "default": 103520000,
          "description": "长按时间"
        },
        {
          "name": "C_FACE_GATE",
          "default": 0,
          "description": "独立旋转工程默认关闭人脸门禁"
        },
        {
          "name": "C_ROTATION_ENABLE",
          "default": 1,
          "description": "独立旋转工程默认开启旋转支路"
        },
        {
          "name": "C_ROTATION_CLOCK_HZ",
          "default": 103520000,
          "description": "旋转时间戳标定"
        },
        {
          "name": "C_FACE_STUMPS",
          "default": "E:/project/ball/fpga/applications/ball_rotation/rtl/face_rom/stumps.mem",
          "description": "保留人脸支路参数，默认关闭时不实例化门禁硬件"
        },
        {
          "name": "C_FACE_STAGES",
          "default": "E:/project/ball/fpga/applications/ball_rotation/rtl/face_rom/stages.mem",
          "description": "保留人脸支路参数，默认关闭时不实例化门禁硬件"
        },
        {
          "name": "C_FACE_COORDINATES",
          "default": "E:/project/ball/fpga/applications/ball_rotation/rtl/face_rom/coordinates.mem",
          "description": "保留人脸支路参数，默认关闭时不实例化门禁硬件"
        }
      ],
      "feature": "rotation"
    }
  ]
