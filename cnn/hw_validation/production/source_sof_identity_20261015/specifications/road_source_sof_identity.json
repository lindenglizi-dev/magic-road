            "description": "o_frame_admit"
          },
          {
            "name": "o_admit_epoch",
            "direction": "output",
            "width": 32,
            "role": "o_admit_epoch",
            "description": "o_admit_epoch"
          },
          {
            "name": "o_admit_frame_id",
            "direction": "output",
            "width": 32,
            "role": "o_admit_frame_id",
            "description": "o_admit_frame_id"
          },
          {
            "name": "o_admit_capture_ms",
            "direction": "output",
