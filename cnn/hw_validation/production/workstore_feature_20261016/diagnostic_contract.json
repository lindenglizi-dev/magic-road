{
  "name": "physical_workstore_diagnostic",
  "modules": [
    {
      "name": "road_feature_workstore_top",
      "rtl_path": "rtl/road_feature_workstore_top.v",
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_mhz": 100
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "synchronous": false
      },
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "与算术owner同域100MHz"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "共同异步复位，服务同时撤销旧响应"
          },
          {
            "name": "i_block_id",
            "direction": "input",
            "width": 4,
            "role": "native",
            "description": "仅start握手锁存的固定块编号"
          },
          {
            "name": "o_block_id",
            "direction": "output",
            "width": 4,
            "role": "native",
            "description": "当前任务身份直到下一次start保持"
          },
          {
            "name": "i_start",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "ready时启动一次完整固定图任务"
          },
          {
            "name": "i_cancel",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "取消后故障占有至共同复位"
          },
          {
            "name": "o_start_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "空闲、无故障且表有效"
          },
          {
            "name": "o_busy",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "包含完成拍和故障占有"
          },
          {
            "name": "o_done",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "末阶段可见性确认后单拍完成"
          },
          {
            "name": "o_fault",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "信任边界错误粘滞指示"
          },
          {
            "name": "o_layer",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "当前块内阶段编号"
          },
          {
            "name": "o_tile_y",
            "direction": "output",
            "width": 7,
            "role": "native",
            "description": "当前四行块起点诊断"
          },
          {
            "name": "o_tile_x",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "当前四列块起点诊断"
          },
          {
            "name": "o_parameter_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前参数分片请求有效"
          },
          {
            "name": "o_parameter_channel",
            "direction": "output",
            "width": 7,
            "role": "native",
            "description": "DW通道或PW输出三通道起点"
          },
          {
            "name": "o_parameter_group",
            "direction": "output",
            "width": 5,
            "role": "native",
            "description": "八输入归约组编号"
          },
          {
            "name": "o_parameter_window",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "DW窗口并集宽度，PW为零"
          },
          {
            "name": "i_parameter_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "参数请求被服务接受"
          },
          {
            "name": "i_parameter_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "参数响应保持至ready"
          },
          {
            "name": "o_parameter_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "只消费当前未完成请求"
          },
          {
            "name": "i_parameter_response_block_id",
            "direction": "input",
            "width": 4,
            "role": "native",
            "description": "响应必须属于当前锁存块"
          },
          {
            "name": "i_parameter_response_layer",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "参数响应阶段身份"
          },
          {
            "name": "i_parameter_response_channel",
            "direction": "input",
            "width": 7,
            "role": "native",
            "description": "参数响应输出通道身份"
          },
          {
            "name": "i_parameter_response_group",
            "direction": "input",
            "width": 5,
            "role": "native",
            "description": "参数响应归约组身份"
          },
          {
            "name": "i_parameter_response_window",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "参数响应DW窗口形态"
          },
          {
            "name": "i_parameter_weight",
            "direction": "input",
            "width": 192,
            "role": "native",
            "description": "三路八输入权重"
          },
          {
            "name": "i_parameter_data",
            "direction": "input",
            "width": 248,
            "role": "native",
            "description": "bias及动态量化字段"
          },
          {
            "name": "i_parameter_error",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "参数服务显式错误"
          },
          {
            "name": "o_read_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "单个16字节行请求有效"
          },
          {
            "name": "o_read_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "十六字节对齐逻辑地址"
          },
          {
            "name": "i_read_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "行请求被内存服务接受"
          },
          {
            "name": "i_read_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "行响应保持至ready"
          },
          {
            "name": "o_read_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "只消费当前未完成行请求"
          },
          {
            "name": "i_read_response_address",
            "direction": "input",
            "width": 32,
            "role": "native",
            "description": "必须匹配请求的对齐地址"
          },
          {
            "name": "i_read_response_data",
            "direction": "input",
            "width": 128,
            "role": "native",
            "description": "低字节对应地址偏移零"
          },
          {
            "name": "i_read_error",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "内存服务显式读错误"
          },
          {
            "name": "o_write_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "合法核结果写请求"
          },
          {
            "name": "o_write_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "完整冻结图字节地址"
          },
          {
            "name": "o_write_data",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "最终饱和INT8结果"
          },
          {
            "name": "o_write_sum",
            "direction": "output",
            "width": 9,
            "role": "native",
            "description": "饱和前signed9残差和"
          },
          {
            "name": "i_write_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "外部写服务接受"
          },
          {
            "name": "o_barrier_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前整层全部写接受后的屏障"
          },
          {
            "name": "i_barrier_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "此层此前写已经可读"
          },
          {
            "name": "i_barrier_block_id",
            "direction": "input",
            "width": 4,
            "role": "native",
            "description": "屏障必须属于当前锁存块"
          },
          {
            "name": "i_barrier_layer",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "屏障确认所属阶段"
          },
          {
            "name": "i_table_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原owner装表有效"
          },
          {
            "name": "i_table_addr",
            "direction": "input",
            "width": 10,
            "role": "native",
            "description": "共享SiLU表地址"
          },
          {
            "name": "i_table_data",
            "direction": "input",
            "width": 16,
            "role": "native",
            "description": "同包Q7.8表项"
          },
          {
            "name": "o_table_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "实际表项接受"
          },
          {
            "name": "o_table_loaded",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "1024项已装满许可"
          }
        ]
      },
      "behavior": [
        "实际固定feature客户、唯一WIF1仓及冻结算术owner直接接线",
        "全部数据接口外露且无常量测试数据替代运算路径",
        "共同reset且SiLU重新装表后才接任务；故障合并不掩盖",
        "仅诊断综合，不是板级引脚或整网顶层"
      ],
      "constraints": [
        "100MHz同域，无新增时序例外",
        "共享仓4ERAM由实际综合确认，原核II/数值/复位不变",
        "只诊断综合，不运行布局布线或位流"
      ],
      "corner_cases": [
        "byte/weight响应等待和背压",
        "共同复位取消旧响应，工作内容重新覆盖",
        "SPPF池化不经过MAC"
      ],
      "verification_cases": [
        "与回归TB相同client/workstore/core源闭包和端口映射",
        "综合硬RAM及算术路径实际保留检查"
      ],
      "timing_diagrams": [
        {
          "id": "workstore",
          "title": "请求到真实提交后响应",
          "scenario": "native_store",
          "description": "具体周期以厂商模型测量为准；核心II不变",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p......"
              },
              {
                "name": "start",
                "wave": "010...."
              },
              {
                "name": "native_access",
                "wave": "0..1..."
              },
              {
                "name": "response",
                "wave": "0...10."
              },
              {
                "name": "core_valid",
                "wave": "0.....1"
              }
            ]
          }
        }
      ]
    }
  ]
}
