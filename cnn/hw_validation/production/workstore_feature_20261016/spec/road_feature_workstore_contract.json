        },
        {
          "id": "weight_completion",
          "title": "权重三word原生提交与同步拼装",
          "scenario": "weight_words",
          "description": "K1/K2/K3同址并行访问两40位片；读在K2/K3/K4捕获，写在K3提交末word，二者K4沿后发布。K6沿退休并接受下一组。",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p......."
              },
              {
                "name": "edge",
                "wave": "========",
                "data": [
                  "K0",
                  "K1",
                  "K2",
