          },
          {
            "name": "i_rlast",
            "direction": "input",
            "width": 1,
            "role": "单拍响应结束标志",
            "description": "单拍响应结束标志"
          },
          {
            "name": "i_rdata",
            "direction": "input",
            "width": 128,
            "role": "全位宽读回数据",
            "description": "全位宽读回数据"
          },
          {
            "name": "o_awaddr",
            "direction": "output",
            "width": 25,
            "role": "native16位字地址",
            "description": "native16位字地址"
          },
          {
            "name": "o_awvalid",
            "direction": "output",
            "width": 1,
            "role": "保持至AW握手",
            "description": "保持至AW握手"
          },
          {
            "name": "o_wdata",
            "direction": "output",
            "width": 128,
            "role": "不随背压变化的写数据",
            "description": "不随背压变化的写数据"
          },
          {
            "name": "o_wstrb",
            "direction": "output",
            "width": 16,
            "role": "位为一则禁止该字节写入",
            "description": "位为一则禁止该字节写入"
          },
          {
            "name": "o_wvalid",
            "direction": "output",
            "width": 1,
            "role": "保持至独立W握手",
            "description": "保持至独立W握手"
          },
          {
            "name": "o_wlast",
            "direction": "output",
            "width": 1,
            "role": "每个命令仅一拍",
            "description": "每个命令仅一拍"
          },
          {
            "name": "o_araddr",
            "direction": "output",
            "width": 25,
            "role": "当前唯一读命令地址",
            "description": "当前唯一读命令地址"
          },
          {
            "name": "o_arvalid",
            "direction": "output",
            "width": 1,
            "role": "读地址提交",
            "description": "读地址提交"
          },
          {
            "name": "o_rready",
            "direction": "output",
            "width": 1,
            "role": "已登记或同拍登记读许可",
            "description": "已登记或同拍登记读许可"
          },
          {
            "name": "o_status",
            "direction": "output",
            "width": 2,
            "role": "零运行、一通过、二首错",
            "description": "零运行、一通过、二首错"
          },
          {
            "name": "o_error",
            "direction": "output",
            "width": 4,
            "role": "失败原因锁存",
            "description": "失败原因锁存"
          },
          {
            "name": "o_state",
            "direction": "output",
            "width": 4,
            "role": "当前协议阶段",
            "description": "当前协议阶段"
          },
          {
            "name": "o_writes",
            "direction": "output",
            "width": 10,
