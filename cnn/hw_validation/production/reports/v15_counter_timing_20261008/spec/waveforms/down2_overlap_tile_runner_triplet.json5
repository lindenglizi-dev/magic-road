{
  signal: [
    {name: 'clk', wave: 'p......|p............'},
    {name: 'mac_valid', wave: '0101010|0............'},
    {name: 'mac_group', wave: 'x3x4x5x|x............', data: ['G0/8', 'G1/8', 'G2/5']},
    {name: 'mac_last', wave: '0....10|0............'},
    {name: 'mac_result', wave: '0......|010..........'},
    {name: 'triplet_buffered', wave: '0......|0.1........0.'},
    {name: 'pp_ready', wave: '1......|1............'},
    {name: 'pp_valid', wave: '0......|0..10.10.10..'},
    {name: 'queue_count', wave: '0......|0...10.10.10.'},
    {name: 'spatial_lane', wave: 'x......|x..3x.4x.5x..', data: ['x', 'x+1', 'x+2']},
    {name: 'advance_task', wave: '0......|0..........10'}
  ],
  head: {text: 'DW spatial triplet: union21 input then three scalar post handshakes'},
  foot: {text: 'The gap omits fixed MAC latency; each valid pulse has one ready handshake'}
