{
  "modules": [
    {
      "name": "road_csp_scheduled_chain",
      "rtl_path": "road_csp_scheduled_chain.v",
      "feature": "scheduled_csp",
      "description": "固定首残差硬件调度及单事务取数；参数/halo端为内部provider，不是外设接口",
      "interfaces": {
        "protocol": "discrete",
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "同域100MHz时钟",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "共同异步取消，释放由现顶层保证",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_start",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "与start_ready握手启动一个固定tile",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_table_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "仅空闲时允许顺序装表，启动与装表互斥",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_table_addr",
            "direction": "input",
            "width": 10,
            "role": "native",
            "description": "原1024项表地址",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_table_data",
            "direction": "input",
            "width": 16,
            "role": "native",
            "description": "原signed16表值",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_start_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "表已满且完全空闲时允许启动",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_table_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "真实装表准入",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_table_loaded",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "核的完整装表许可",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_busy",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前tile占有",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_done",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "所有任务末路提交后完成",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_fault",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "核/缓存/描述符故障，仅共同复位恢复",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_operand_request_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "单个取数请求，保持到ready",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_request_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "取数端接收请求",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_operand_request_descriptor",
            "direction": "output",
            "width": 25,
            "role": "native",
            "description": "沿冻结task/pw/y/x/channel/first/last/mask布局",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "取数响应，保持全部载荷到ready",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_operand_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "已登记请求且尚未保存响应",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_response_descriptor",
            "direction": "input",
            "width": 25,
            "role": "native",
            "description": "必须回显当前唯一请求，失配置错不计算",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_activation",
            "direction": "input",
            "width": 64,
            "role": "native",
            "description": "仅DW采用；PW忽略此字段而读取实际缓存",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_weight",
            "direction": "input",
            "width": 192,
            "role": "native",
            "description": "三路八输入权重",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_bias",
            "direction": "input",
            "width": 96,
            "role": "native",
            "description": "三路INT32偏置",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_pre_multipliers",
            "direction": "input",
            "width": 96,
            "role": "native",
            "description": "三路真实前乘数",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_pre_shifts",
            "direction": "input",
            "width": 18,
            "role": "native",
            "description": "三路六位移位",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_post_multiplier",
            "direction": "input",
            "width": 32,
            "role": "native",
            "description": "当前层后乘数",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_post_shift",
            "direction": "input",
            "width": 6,
            "role": "native",
            "description": "当前层后移位",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_bypass",
            "direction": "input",
            "width": 24,
            "role": "native",
            "description": "PW残差三路原输入旁路",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_operand_fault",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "首组输入故障标志",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_result_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "结果接收端的真实ready",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_result_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "与DW缓存原子提交的结果valid",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_result_data",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "真实INT8结果",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_result_tag",
            "direction": "output",
            "width": 16,
            "role": "native",
            "description": "RTL根据任务坐标派生的tag",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_result_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "冻结逻辑字节地址",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_result_sum",
            "direction": "output",
            "width": 9,
            "role": "native",
            "description": "真实残差饱和前和",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_group_accept",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "MAC真实接收一组",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_task_commit",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前任务最后一路已实际提交",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_request_accept",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "取数请求真实接受",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_cache_read_accept",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "PW缓存请求真实接受",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_cache_write_accept",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "DW缓存字节真实接受",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_cycle_reason",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "0空闲/1MAC发射/2请求阶段/3响应等待接收/4缓存等待/5MAC等待/6写端反压/7其他流水提交",
            "clock_domain": "i_clk"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_hz": 100000000
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "synchronous": false
      },
      "parameters": [],
      "behavior": [
        "160任务/320组由冻结调度器产生；一笔取数在途，响应与PW缓存数据各锁存，齐备才送原核。",
        "PW输入忽略provider activation，来自真实DW缓存；tag/逻辑地址由RTL坐标计算。",
        "三路或单路结果全部实际提交才task_done；每次tile开始局部清缓存，不复位核或重装SiLU。",
        "共同reset取消所有暂存；provider必须共同取消旧响应，本接口不能直接接DDR晚返回。"
      ],
      "constraints": [
        "不改核端口/数值/II；串行请求适配可能增加组间间隔，按端点周期测量而不冒称II加速。",
        "提供者在空闲装表时具有优先级，忙时装表不被接受；仅单上下文，不新增队列或外设。"
      ],
      "corner_cases": [
        "响应先于/晚于缓存、长结果反压、首末组、1/3路提交、reset、双tile及失配响应。"
      ],
      "verification_cases": [
        "实际acc/pre/SiLU/post/sum/地址/输出；随机provider与反压；故障及reset；旧回归单列。"
      ],
      "timing_diagrams": [
        {
          "id": "join",
          "scenario": "join",
          "title": "取数与PW缓存汇合再发射",
          "description": "同一个请求对应两路锁存；MAC真实接受后才推进组。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p......."
              },
              {
                "name": "request_accept",
                "wave": "010....."
              },
              {
                "name": "cache_capture",
                "wave": "0.10...."
              },
              {
                "name": "payload_capture",
                "wave": "0...10.."
              },
              {
                "name": "mac_accept",
                "wave": "0....10."
              },
              {
                "name": "next_request",
                "wave": "0.....10"
              }
            ]
          }
        }
      ]
    }
  ]
}
