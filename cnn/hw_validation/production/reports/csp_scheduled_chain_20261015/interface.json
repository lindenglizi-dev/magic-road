{
  "module": "road_csp_scheduled_chain",
  "ports": [
    {
      "name": "i_clk",
      "direction": "input",
      "width": 1,
      "description": "同域100MHz时钟"
    },
    {
      "name": "i_rstn",
      "direction": "input",
      "width": 1,
      "description": "共同异步取消，释放由现顶层保证"
    },
    {
      "name": "i_start",
      "direction": "input",
      "width": 1,
      "description": "与start_ready握手启动一个固定tile"
    },
    {
      "name": "i_table_valid",
      "direction": "input",
      "width": 1,
      "description": "仅空闲时允许顺序装表，启动与装表互斥"
    },
    {
      "name": "i_table_addr",
      "direction": "input",
      "width": 10,
      "description": "原1024项表地址"
    },
    {
      "name": "i_table_data",
      "direction": "input",
      "width": 16,
      "description": "原signed16表值"
    },
    {
      "name": "o_start_ready",
      "direction": "output",
      "width": 1,
      "description": "表已满且完全空闲时允许启动"
    },
    {
      "name": "o_table_ready",
      "direction": "output",
      "width": 1,
      "description": "真实装表准入"
    },
    {
      "name": "o_table_loaded",
      "direction": "output",
      "width": 1,
      "description": "核的完整装表许可"
    },
    {
      "name": "o_busy",
      "direction": "output",
      "width": 1,
      "description": "当前tile占有"
    },
    {
      "name": "o_done",
      "direction": "output",
      "width": 1,
      "description": "所有任务末路提交后完成"
    },
    {
      "name": "o_fault",
      "direction": "output",
      "width": 1,
      "description": "核/缓存/描述符故障，仅共同复位恢复"
    },
    {
      "name": "o_operand_request_valid",
      "direction": "output",
      "width": 1,
      "description": "单个取数请求，保持到ready"
    },
    {
      "name": "i_operand_request_ready",
      "direction": "input",
      "width": 1,
      "description": "取数端接收请求"
    },
    {
      "name": "o_operand_request_descriptor",
      "direction": "output",
      "width": 25,
      "description": "沿冻结task/pw/y/x/channel/first/last/mask布局"
    },
    {
      "name": "i_operand_response_valid",
      "direction": "input",
      "width": 1,
      "description": "取数响应，保持全部载荷到ready"
    },
    {
      "name": "o_operand_response_ready",
      "direction": "output",
      "width": 1,
      "description": "已登记请求且尚未保存响应"
    },
    {
      "name": "i_operand_response_descriptor",
      "direction": "input",
      "width": 25,
      "description": "必须回显当前唯一请求，失配置错不计算"
    },
    {
      "name": "i_operand_activation",
      "direction": "input",
      "width": 64,
      "description": "仅DW采用；PW忽略此字段而读取实际缓存"
    },
    {
      "name": "i_operand_weight",
      "direction": "input",
      "width": 192,
      "description": "三路八输入权重"
    },
    {
      "name": "i_operand_bias",
      "direction": "input",
      "width": 96,
      "description": "三路INT32偏置"
    },
    {
      "name": "i_operand_pre_multipliers",
      "direction": "input",
      "width": 96,
      "description": "三路真实前乘数"
    },
    {
      "name": "i_operand_pre_shifts",
      "direction": "input",
      "width": 18,
      "description": "三路六位移位"
    },
    {
      "name": "i_operand_post_multiplier",
      "direction": "input",
      "width": 32,
      "description": "当前层后乘数"
    },
    {
      "name": "i_operand_post_shift",
      "direction": "input",
      "width": 6,
      "description": "当前层后移位"
    },
    {
      "name": "i_operand_bypass",
      "direction": "input",
      "width": 24,
      "description": "PW残差三路原输入旁路"
    },
    {
      "name": "i_operand_fault",
      "direction": "input",
      "width": 1,
      "description": "首组输入故障标志"
    },
    {
      "name": "i_result_ready",
      "direction": "input",
      "width": 1,
      "description": "结果接收端的真实ready"
    },
    {
      "name": "o_result_valid",
      "direction": "output",
      "width": 1,
      "description": "与DW缓存原子提交的结果valid"
    },
    {
      "name": "o_result_data",
      "direction": "output",
      "width": 8,
      "description": "真实INT8结果"
    },
    {
      "name": "o_result_tag",
      "direction": "output",
      "width": 16,
      "description": "RTL根据任务坐标派生的tag"
    },
    {
      "name": "o_result_address",
      "direction": "output",
      "width": 32,
      "description": "冻结逻辑字节地址"
    },
    {
      "name": "o_result_sum",
      "direction": "output",
      "width": 9,
      "description": "真实残差饱和前和"
    },
    {
      "name": "o_group_accept",
      "direction": "output",
      "width": 1,
      "description": "MAC真实接收一组"
    },
    {
      "name": "o_task_commit",
      "direction": "output",
      "width": 1,
      "description": "当前任务最后一路已实际提交"
    },
    {
      "name": "o_request_accept",
      "direction": "output",
      "width": 1,
      "description": "取数请求真实接受"
    },
    {
      "name": "o_cache_read_accept",
      "direction": "output",
      "width": 1,
      "description": "PW缓存请求真实接受"
    },
    {
      "name": "o_cache_write_accept",
      "direction": "output",
      "width": 1,
      "description": "DW缓存字节真实接受"
    },
    {
      "name": "o_cycle_reason",
      "direction": "output",
      "width": 3,
      "description": "0空闲/1MAC发射/2请求阶段/3响应等待接收/4缓存等待/5MAC等待/6写端反压/7其他流水提交"
    }
  ],
  "instance_names": {
    "wrapper": "u_compute",
    "scheduler": "u_schedule",
    "cache": "u_cache"
  },
  "descriptor": "[24:17]task,[16]pw,[15:14]y,[13:12]x,[11:8]channel,[7]first,[6]last,[5:3]mask,[2:0]zero",
  "provider": "one request outstanding; response descriptor echo; reset requires provider cancel; no DDR late returns",
  "cache_clear": "new cache candidate i_clear, synchronous, only idle tile boundary; sticky fault still reset-only",
  "result_addresses": {
    "dw": 56532992,
    "residual": 56643584
  }
}
