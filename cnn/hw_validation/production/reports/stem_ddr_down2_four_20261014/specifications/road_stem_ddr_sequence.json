                  "STEM_LOAD",
                  "STEM_RUN",
                  "STEM_EXPORT",
                  "WRITE_ACCEPT",
                  "READ",
                  "HALO_LOAD",
                  "DW_PW",
                  "PASS"
                ]
              },
              {
                "name": "req_valid",
                "wave": "0...1.0.."
              },
              {
                "name": "rsp_valid",
                "wave": "0....1.0."
              },
              {
                "name": "DDR_payload",
