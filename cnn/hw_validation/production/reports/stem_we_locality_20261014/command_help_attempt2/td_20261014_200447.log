move_cells                              -inst { inst, ... } -location { x*y*, ... } -mode {enforce/nonforce/f78mux} -step {place/route} -cong_thod
[-mode]                                 enforce mode will find a location surrounding and move in, nonforce mode will only try specified location
[-step]                                 ph1 support move_cells after place and route, ph2 support move_cells after place
[-cong_thod]                            set congestion threshold for destination

report_cells                            get_cells <cell name> -connection -mode <string> -timing ...
[get_cells <cell name>]                 Print cell attributes
[-attributes]                           Print detailed cell attributes
[-connection]                           Print each pin of the cell, and the net connected
[-pin_loc]                              Print location of each pin of the cell, based on [-connection]
[-mode <mode>]                          Used with [-timing]/[-dsp]/[-bram]/[-mux]/[-shifter]/[-dramhardcon], set mode
[-timing]                               Print the slack of each pin based on [-connection], mode can be <basic/manhattan/final>
[-grid <coord>]                         Print all cells in the grid specified with col and row, e.g x21y54
[-entity <id>]                          Print all packed cells in the specified id entity
[-dsp -mux -bram -shifter -dramhardcon] Print all dsp/mux/bram/shifter/dramhardrcon information, include name, location and slack
[-file <file name>]                     Used with [-dsp]/[-bram]/[-mux]/[-shifter]/[-dramhardcon], export information to file
[-export_adc -export_init_adc]          Used with [-dsp]/[-bram]/[-dramhardcon], export adc information to generated adc file
[-empty_location]                       Used with [-dsp]/[-bram], print empty bram/dsp location information

place                                   [-eco] [-keep_pad] [-export_adc]
[-eco]                                  To process unplaced instances only, legal instance locations are taken.
[-keep_pad]                             Opt command
[-export_adc]                           To save current IO placement as adc constraint file.

route                                   [-eco] [-incremental] [-verbose]
[-eco]                                  To process unrouted nets only, routed legal nets are fixed.
[-incremental]                          To process unrouted nets only, routed legal nets can be changed.
[-verbose]                              To print detailed run logs.

