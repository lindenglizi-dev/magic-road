[-effort]                               Control effort level of phys_opt, value can be low/middle/high/ultra
[-register_opt]                         Do register optimization on BRAM
[-lut_merge]                            Do lut merge to optimize redundant logic levels
[-simplify_lut]                         Do simplify lut to optimize const net lut and duplicate net lut
[-merge_lut1]                           Do merge lut1 to optimize eqn=(~A) LUT1
[-force_replication_on_nets]            Do HFN replication on specifed nets
[-fanout_threshold]                     Specify high fanout number in HFN optimization
[-post_place]                           Do post-place optimization
[-post_route]                           Do post-route optimization with cell relocation
[-mode]                                 Specify post-route opt mode, valid modes are relocation and reroute
[-hold_fix]                             Do hold fixing with severe violations in pre-route stage
[-post_clock_route]                     Do physical optimization with clock net routed

