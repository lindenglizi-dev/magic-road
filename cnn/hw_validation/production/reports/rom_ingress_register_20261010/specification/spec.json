                "wave": "0..1...."
              },
              {
                "name": "runner_valid",
                "wave": "01..0..."
              },
              {
                "name": "pref_done",
                "wave": "0...1..."
              },
              {
                "name": "table_loaded",
                "wave": "0...1..."
              },
              {
                "name": "external_owner",
                "wave": "0....1.."
              }
            ]
          }
        }
      ]
