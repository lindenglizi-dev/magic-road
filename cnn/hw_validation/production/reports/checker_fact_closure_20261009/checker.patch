+# _unpacked_array_root_drivers 将 formatter 已确认的数组元素写回声明根事实。
+def _unpacked_array_root_drivers(
+    dict_module: dict[str, Any],
+    dict_declarations: dict[str, dict[str, Any]],
+) -> tuple[set[str], set[str]]:
+    """返回可确认有过程写入的 unpacked array 声明根。
+
+    动态索引只能证明声明根存在驱动，不能证明每个元素均已初始化。常量索引
+    仅在覆盖静态声明的全部元素时提升为根驱动，避免 ``array[0]`` 遮蔽
+    ``array[1]`` 的未驱动读取。packed select 不在本函数适用范围内。
+    """
+
+    # 现有常量求值器同时识别十进制、based literal、parameter 和 localparam。
+    dict_constant_values = module_constant_values(dict_module)  # 当前模块常量原文
+    dict_integer_values = module_instance_parameter_values(dict_module)  # 当前模块确定整数环境
+
+    # 只接纳端点可确定的单一 unpacked 维度；多维或未知范围保留原 VG153 诊断。
+    dict_unpacked: dict[str, tuple[int, int]] = {}  # 声明根到静态单维闭区间
+    for str_name, dict_declaration in dict_declarations.items():
+        str_unpacked = str(dict_declaration["object"].get("unpacked") or "").strip()
+        match_range = re.fullmatch(r"\[\s*([^:\[\]]+)\s*:\s*([^:\[\]]+)\s*\]", str_unpacked)
+        if match_range is None:
+            continue
+        int_left = constant_integer(match_range.group(1), dict_integer_values)
+        int_right = constant_integer(match_range.group(2), dict_integer_values)
+        if int_left is not None and int_right is not None:
+            dict_unpacked[str_name] = (int_left, int_right)
+
+    # 动态根与常量元素分别收集；两者不能互相冒充覆盖证明。
+    set_dynamic_roots: set[str] = set()  # 仅证明存在运行期索引过程写入的声明根
+    dict_constant_indices: dict[str, set[int]] = {str_name: set() for str_name in dict_unpacked}
+
+    # always.targets/lvalues 都来自 formatter AST，不重新解析 RTL 源文件。
+    for dict_always in dict_module.get("always", []) or []:
+
+        # targets 已把复杂左值归一到声明根，先限定为真实 unpacked 声明。
+        set_targets = set(str_name for str_name in dict_always.get("targets", []) or []) & set(dict_unpacked)
+
+        # lvalues 保留元素选择文本，用于区分动态索引与单个常量元素。
+        for str_lvalue in (str(value) for value in dict_always.get("lvalues", []) or []):
+
+            # 只检查 formatter 已归属于当前 always 的候选声明根。
+            for str_name in set_targets:
+
+                # 仅完整的一维元素左值进入求值；元素内 packed select 和多维选择不匹配。
+                match_element = re.fullmatch(
+                    rf"\s*{re.escape(str_name)}\s*\[\s*(.+)\s*\]\s*",
+                    str_lvalue,
+                )
+                if match_element is None:
+                    continue
+
+                # selector 先通过共享常量事实求值，based literal 和参数常量不得冒充动态索引。
+                str_selector = match_element.group(1).strip()  # formatter lvalue 中的元素 selector
+                int_selector = constant_integer(str_selector, dict_integer_values)
+                if int_selector is None:
+                    obj_bits = resolve_constant_bits(str_selector, dict_constant_values)
+                    if obj_bits is not None and set(obj_bits.bits) <= {"0", "1"}:
+                        int_selector = int(obj_bits.bits, 2)
+                if int_selector is not None:
+                    dict_constant_indices[str_name].add(int_selector)
+                    continue
+
+                # 共享 expression parser 必须确认 selector 是一个完整表达式且至少含一个运行期信号。
+                dict_selector = build_instance_actual_fact(str_selector)
+                set_references = set(str(value) for value in dict_selector.get("references", ()) or ())
+                set_runtime_names = {
+                    str(value.get("name") or "")
+                    for value in dict_module.get("ports", []) or []
+                    if value.get("name")
+                } | {
+                    name
+                    for name, declaration in dict_declarations.items()
+                    if declaration["kind"] not in {"params", "localparams"}
+                }
+                set_known_names = set_runtime_names | set(dict_constant_values)
+                if (
+                    dict_selector.get("expression") is not None
+                    and bool(set_references & set_runtime_names)
+                    and set_references <= set_known_names
+                ):
+                    set_dynamic_roots.add(str_name)
+
+    # 全部静态元素均有写入时，常量元素集合也可安全提升为声明根驱动。
+    set_complete_roots: set[str] = set()  # 已覆盖完整静态 unpacked range 的声明根
+    for str_name, (int_left, int_right) in dict_unpacked.items():
+        set_in_range = {
+            value
+            for value in dict_constant_indices[str_name]
+            if min(int_left, int_right) <= value <= max(int_left, int_right)
+        }
+        int_required_count = abs(int_left - int_right) + 1
+        if (
+            len(set_in_range) == int_required_count
+            and min(set_in_range, default=None) == min(int_left, int_right)
+            and max(set_in_range, default=None) == max(int_left, int_right)
+        ):
+            set_complete_roots.add(str_name)
+
+    # 第二项专门标记粗粒度动态事实，供报告声明其能力边界。
+    return set_dynamic_roots | set_complete_roots, set_dynamic_roots
+
