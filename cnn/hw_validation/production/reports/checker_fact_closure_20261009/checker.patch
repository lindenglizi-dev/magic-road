-                # 离开当前节点前清理递归栈。
-                set_visiting.remove(str_node)
-
-                # 向上传播闭环标记。
-                return None
-
-            # 合并当前子图的全部叶子。
-            set_leaves.update(set_child)
-
-        # 当前节点完成后退出递归栈。
-        set_visiting.remove(str_node)
-
-        # 缓存完整叶子集合供共享子图复用。
-        dict_memo[str_node] = set(set_leaves)  # 当前节点展开缓存
-
-        # 返回当前目标的完整组合来源。
