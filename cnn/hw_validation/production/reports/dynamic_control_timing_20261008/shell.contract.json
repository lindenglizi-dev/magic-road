            "clock_domain": "i_clk"
          },
          {
            "name": "i_tx_ready",
            "width": 1,
            "direction": "input",
            "role": "i_tx_ready",
            "description": "i_tx_ready",
            "clock_domain": "i_clk"
          }
        ],
        "handshake_channels": [
          {
            "id": "table",
            "valid": "i_table_valid",
            "ready": "o_table_ready",
            "payload": [
              "i_table_addr",
              "i_table_data"
            ]
          },
          {
