{
  "modules": [
    {
      "name": "road_dynamic_low_io_top",
      "feature": "dynamic_low_io",
      "rtl_path": "road_dynamic_low_io_top.v",
      "description": "38-bit runtime-loaded diagnostic shell for frozen dynamic serial postprocessing.",
      "interfaces": {
