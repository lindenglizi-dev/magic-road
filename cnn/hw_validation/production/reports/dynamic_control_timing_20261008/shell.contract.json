            "description": "i_rstn",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_rx_valid",
            "width": 1,
            "direction": "input",
            "role": "i_rx_valid",
            "description": "i_rx_valid",
            "clock_domain": "i_clk"
          },
          {
            "name": "i_rx_data",
            "width": 16,
            "direction": "input",
            "role": "i_rx_data",
            "description": "i_rx_data",
            "clock_domain": "i_clk"
          },
          {
            "name": "o_rx_ready",
