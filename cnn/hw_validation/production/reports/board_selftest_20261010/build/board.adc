# Only project-declared six logical ports; physical board revision remains unverified.
set_pin_assignment { i_sys_clk } { LOCATION = C4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { i_rstn } { LOCATION = R10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { o_tmds_blue_p } { LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { o_tmds_green_p } { LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { o_tmds_red_p } { LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { o_tmds_clock_p } { LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
