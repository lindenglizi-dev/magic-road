                "wave": "p..............."
              },
              {
                "name": "i_input_valid",
                "wave": "010............."
              },
              {
                "name": "o_input_ready",
                "wave": "1.........0..1.."
              },
              {
                "name": "o_output_valid",
                "wave": "0.........1...0."
              },
              {
                "name": "o_output_data",
                "wave": "x.........3.....",
                "data": [
                  "result"
                ]
              },
              {
                "name": "i_output_ready",
                "wave": "0............1.."
              }
            ]
          }
        }
      ]
    }
  ]
