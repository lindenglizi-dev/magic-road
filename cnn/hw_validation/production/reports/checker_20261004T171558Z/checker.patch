 # evaluate_liveness_gate 执行 VG153 和 VG154。
+def _static_width(item: dict[str, Any]) -> int | None:
+    """仅证明静态完整总线；参数、数组和部分连接保持阻断。"""
+    if item.get("unpacked"):
+        return None
+    width = re.sub(r"\s+", "", str(item.get("width") or ""))
+    if not width:
+        return 1
+    match = re.fullmatch(r"\[(\d+):(\d+)\]", width)
+    return abs(int(match[1]) - int(match[2])) + 1 if match else None
+
+
+def _instance_drivers(module, local_facts, catalog):
+    """从已有 formatter AST 证明命名连接的唯一输出驱动，不重解析 RTL。"""
+    declared = {name: item["object"] for name, item in local_facts["declarations"].items()}
+    declared.update({port["name"]: port for port in module.get("ports", [])})
+    candidates = {}
+    unresolved = set()
+    for instance in module.get("instances", []):
+        child = catalog.get(instance.get("module_name"))
+        if child is None:
+            continue  # 未知接口仍由 VG097 和原 VG153 阻断，绝不伪造驱动。
+        formals = {port["name"]: port for port in child.get("ports", [])}
+        for association in instance.get("port_associations", []):
+            formal = formals.get(association.get("formal_name"))
+            if formal is None or formal.get("direction") != "output":
+                continue
+            actual = association.get("actual") or {}
+            names = set(actual.get("references") or [])
+            name = str(actual.get("text") or "").strip()
+            node = actual.get("expression") or {}
+            parent = declared.get(name)
+            supported = (
+                instance.get("parse_complete") and instance.get("association_style") == "named"
+                and not instance.get("has_params") and not instance.get("parameter_overrides")
+                and not instance.get("array_range_text")
+                and not child.get("params") and not child.get("generates") and not module.get("generates")
+                and parent is not None and parent.get("kind", "wire") == "wire"
+                and actual.get("kind") == "expression" and names == {name}
+                and node.get("node_kind") == "identifier" and (node.get("name") or node.get("text")) == name
+                and actual.get("static_lvalue_segments") == [{"name": name}]
+                and _static_width(parent) is not None and _static_width(parent) == _static_width(formal)
+                and bool(parent.get("signed")) == bool(formal.get("signed"))
+            )
+            if not supported:
+                unresolved.update(names or {name or "<unresolved_actual>"})
+                continue
+            candidates.setdefault(name, []).append(instance.get("instance_name"))
+    drivers = set()
+    for name, instances in candidates.items():
+        if len(instances) != 1 or name in local_facts["drivers"] or name in unresolved:
+            unresolved.add(name)
+        else:
+            drivers.add(name)
+    return drivers, unresolved
+
+
