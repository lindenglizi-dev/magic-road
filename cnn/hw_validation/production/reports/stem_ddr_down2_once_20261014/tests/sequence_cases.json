{
  "schema": 1,
  "clock_mhz": 100,
  "dut": "road_stem_ddr_sequence",
  "timeout_cycles": 20000,
  "plusargs": ["+CASE=<0..12>", "+VECTORS=<absolute-vector-directory>"],
  "endpoint": {
    "kind": "direct controllable request/response memory",
    "storage": "64 sparse entries by stem_addresses.hex index",
    "write_response": "accepted only",
    "read_source": "previously accepted write payload; golden is comparator only",
    "reset": "endpoint and DUT clear together; no transaction recovery"
  },
  "cases": [
    {"id": 0, "name": "normal", "expected_status": 1, "expected_error": 0},
    {"id": 1, "name": "random_request_bubbles_and_response_latency", "expected_status": 1, "expected_error": 0},
    {"id": 2, "name": "long_request_and_response_wait", "expected_status": 1, "expected_error": 0},
    {"id": 3, "name": "read_data_flip", "expected_status": 2, "expected_error": 5},
    {"id": 4, "name": "response_error", "expected_status": 2, "expected_error": 7},
    {"id": 5, "name": "reset_during_stem_run_then_rerun", "expected_status": 1, "expected_error": 0, "expected_generations": 2},
    {"id": 6, "name": "reset_while_write_request_waits_then_rerun", "expected_status": 1, "expected_error": 0, "expected_generations": 2},
    {"id": 7, "name": "reset_while_read_request_waits_then_rerun", "expected_status": 1, "expected_error": 0, "expected_generations": 2},
    {"id": 8, "name": "reset_during_halo_load_then_rerun", "expected_status": 1, "expected_error": 0, "expected_generations": 2},
    {"id": 9, "name": "reset_during_down2_run_then_rerun", "expected_status": 1, "expected_error": 0, "expected_generations": 2},
    {"id": 10, "name": "reset_during_final_output_then_rerun", "expected_status": 1, "expected_error": 0, "expected_generations": 2},
    {"id": 11, "name": "dropped_read_response_timeout", "expected_status": 2, "expected_error": 9},
    {"id": 12, "name": "ddr_fault_after_pass", "expected_status": 2, "expected_error": 1, "requires_full_pass_before_fault": true}
  ]
}
