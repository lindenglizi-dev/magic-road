{
  signal: [
    {name: 'clk', wave: 'p..|p..'},
    {name: 'state_idle', wave: '1..|0..'},
    {name: 'load_valid', wave: '010|0..'},
    {name: 'load_ready', wave: '1..|0..'},
    {name: 'commit_valid', wave: '0..|010'},
    {name: 'cache_write', wave: '010|010'},
    {name: 'cache_source', wave: 'x3x|x4x', data: ['preload', 'commit']},
    {name: 'fault', wave: '0..|0..'}
  ],
  head: {text: '预装载与 DW 提交接口片段：竖线省略计算间隔'},
  foot: {text: '两个握手阶段不相邻；单写口不增加原握手延迟'}
}
