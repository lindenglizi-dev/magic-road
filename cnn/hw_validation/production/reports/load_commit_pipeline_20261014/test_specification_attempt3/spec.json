{
  "modules": [
    {
      "name": "tb_load_commit_pipeline",
      "feature": "load_commit_equivalence",
      "rtl_path": "tb_load_commit_pipeline.v",
      "description": "延迟一拍写入的独立记分板；接收元数据与原源锁步，复位取消允许旧存储有意不同。",
      "interfaces": {
        "protocol": "discrete",
        "ports": [
          {
            "name": "o_test_done",
            "direction": "output",
            "width": 1,
            "clock_domain": "clk",
            "role": "test_complete",
            "description": "全部断言通过后置1并结束仿真。"
          }
        ]
      },
      "parameters": [],
      "clock": {
        "name": "clk",
        "frequency_hz": 100000000,
        "edge": "posedge",
        "internal": true
      },
      "reset": {
        "name": "rstn",
        "active": "low",
        "synchronous": false,
        "internal": true
      },
      "behavior": [
        "接受/ready/fault/cursor/loaded按原源逐沿比较。",
        "每个合法接受登记一项，下一沿更新期望存储；仅比较已初始化字节。",
        "复位清待提交模型，保留已提交字节；旧源取消前已写入的字节可与候选有意不同。",
        "432权重连续432拍、1296halo连续1296拍；末提交与单拍start同沿，首个MAC读数据完整。"
      ],
      "constraints": [
        "测试专用，不综合，不属于数值精度或完整CNN FPS证据。"
      ],
      "corner_cases": [
        "63/64、127/128、639/640、703/704、431/432、1295/1296及地址0重启。"
      ],
      "verification_cases": [
        "TB_PASS_LOAD_COMMIT checks=1728；精确连续耗时断言；完整首读和旧8组数值回归另记。"
      ],
      "timing_diagrams": [
        {
          "id": "queued_write",
          "scenario": "queued_write",
          "title": "记分板验证一拍提交",
          "description": "接收A/B连续两拍，候选存储晚一拍；元数据同沿，末项提交后完整数组一致。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p....."
              },
              {
                "name": "accept",
                "wave": "0110.."
              },
              {
                "name": "legacy_write",
                "wave": "0110.."
              },
              {
                "name": "candidate_write",
                "wave": "0.110."
              },
              {
                "name": "compare_complete_arrays",
                "wave": "0...10"
              }
            ]
          }
        }
      ]
    }
  ]
}