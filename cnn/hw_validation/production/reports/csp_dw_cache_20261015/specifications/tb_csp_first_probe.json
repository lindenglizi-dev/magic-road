{
  "modules": [
    {
      "name": "tb_csp_first_probe",
      "feature": "csp_cache_test",
      "rtl_path": "tb_csp_first_probe.v",
      "description": "缓存握手及实际计算回归，不是整网或DDR验收",
      "interfaces": {
        "protocol": "discrete",
        "ports": [
          {
            "name": "o_test_complete",
            "direction": "output",
            "width": 1,
            "role": "test_complete",
            "description": "全部检查通过后置位",
            "clock_domain": "clk"
          }
        ]
      },
      "clock": {
        "name": "clk",
        "edge": "posedge",
        "frequency_hz": 100000000,
        "internal": true
      },
      "reset": {
        "name": "rstn",
        "active": "low",
        "synchronous": false,
        "internal": true
      },
      "parameters": [],
      "behavior": [
        "采集阶段只写不读，全部192个唯一结果到齐后只读不写。",
        "每读请求一个上升沿后产生64bit注册响应；一槽可同拍出入。",
        "reset清有效位/计数/响应，不清RAM；恢复后必须完整重写，禁止旧响应泄漏。"
      ],
      "constraints": [
        "仅测试，不可综合"
      ],
      "corner_cases": [
        "最后一字节、索引191/192/255、重复写、请求/响应停顿、复位中断。"
      ],
      "verification_cases": [
        "32组数据对拍、随机写序、长响应反压、未满不读、故障及复位；17项真实计算回归。"
      ],
      "timing_diagrams": [
        {
          "id": "read",
          "scenario": "read",
          "title": "完整采集后注册读取及响应保持",
          "description": "最后一字节写入之后开放读，接受读的上升沿后产生响应；停顿时数据和元数据保持。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p......"
              },
              {
                "name": "loaded",
                "wave": "01....."
              },
              {
                "name": "read_valid",
                "wave": "0.10..."
              },
              {
                "name": "output_valid",
                "wave": "0..1..0"
              },
              {
                "name": "output_ready",
                "wave": "0....1."
              },
              {
                "name": "output_data",
                "wave": "x..=..x",
                "data": [
                  "held group"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
