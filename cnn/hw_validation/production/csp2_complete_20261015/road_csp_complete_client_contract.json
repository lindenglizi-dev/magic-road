{
  "name": "csp_complete_client",
  "modules": [
    {
      "name": "road_csp_complete_client",
      "rtl_path": "rtl/road_csp_complete_client.v",
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_mhz": 100
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "synchronous": false
      },
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "与算术owner同域100MHz"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "共同复位，外部服务须同时取消旧响应"
          },
          {
            "name": "i_start",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "ready时接受一个固定图tile"
          },
          {
            "name": "i_tile_y",
            "direction": "input",
            "width": 7,
            "role": "native",
            "description": "0至68且四对齐"
          },
          {
            "name": "i_tile_x",
            "direction": "input",
            "width": 8,
            "role": "native",
            "description": "0至124且四对齐"
          },
          {
            "name": "i_cancel",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "取消后不释放外部存储，需共同复位"
          },
          {
            "name": "i_table_loaded",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "外部owner已有同包完整SiLU表"
          },
          {
            "name": "o_start_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "空闲且表有效才接任务"
          },
          {
            "name": "o_busy",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "故障时保持占有，不冒充排空"
          },
          {
            "name": "o_done",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "末层可见性确认后一拍完成"
          },
          {
            "name": "o_fault",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "粘滞协议错误"
          },
          {
            "name": "o_layer",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "当前五个卷积阶段"
          },
          {
            "name": "o_parameter_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "一组参数读取请求"
          },
          {
            "name": "o_parameter_channel",
            "direction": "output",
            "width": 5,
            "role": "native",
            "description": "DW通道或PW三输出起点"
          },
          {
            "name": "o_parameter_group",
            "direction": "output",
            "width": 2,
            "role": "native",
            "description": "八输入组编号"
          },
          {
            "name": "o_parameter_window",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "DW并集宽3或5；PW为0"
          },
          {
            "name": "i_parameter_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "请求真实被参数服务接受"
          },
          {
            "name": "i_parameter_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "注册参数响应，保持至response_ready"
          },
          {
            "name": "o_parameter_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "仅等待本请求时消费"
          },
          {
            "name": "i_parameter_response_layer",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "响应阶段身份"
          },
          {
            "name": "i_parameter_response_channel",
            "direction": "input",
            "width": 5,
            "role": "native",
            "description": "响应输出通道身份"
          },
          {
            "name": "i_parameter_response_group",
            "direction": "input",
            "width": 2,
            "role": "native",
            "description": "响应归约组身份"
          },
          {
            "name": "i_parameter_response_window",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "响应DW窗口形态"
          },
          {
            "name": "i_parameter_weight",
            "direction": "input",
            "width": 192,
            "role": "native",
            "description": "OIHW映射到三路八输入"
          },
          {
            "name": "i_parameter_data",
            "direction": "input",
            "width": 248,
            "role": "native",
            "description": "原bias/pre/post字段紧凑排列"
          },
          {
            "name": "i_parameter_error",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "外部参数读取故障"
          },
          {
            "name": "o_read_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "单个逻辑字节读请求"
          },
          {
            "name": "o_read_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "冻结graph逻辑字节，非native地址"
          },
          {
            "name": "i_read_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "服务接受请求，不代表响应已到"
          },
          {
            "name": "i_read_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "一次请求对应一次注册响应"
          },
          {
            "name": "o_read_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "不接受其它任务旧响应"
          },
          {
            "name": "i_read_response_address",
            "direction": "input",
            "width": 32,
            "role": "native",
            "description": "与请求绑定的字节地址"
          },
          {
            "name": "i_read_response_data",
            "direction": "input",
            "width": 8,
            "role": "native",
            "description": "真正读取的INT8字节"
          },
          {
            "name": "i_read_error",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "服务显式读错误"
          },
          {
            "name": "o_write_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "合法算术结果才向外发布"
          },
          {
            "name": "o_write_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "本次真实写地址"
          },
          {
            "name": "o_write_data",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "融合后sat8值"
          },
          {
            "name": "o_write_sum",
            "direction": "output",
            "width": 9,
            "role": "native",
            "description": "饱和前精确残差和"
          },
          {
            "name": "i_write_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "写服务接受，尚不等于可见"
          },
          {
            "name": "o_barrier_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "本阶段全部写接受后请求可见性屏障"
          },
          {
            "name": "i_barrier_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "明确保证此前写可供后续读消费"
          },
          {
            "name": "i_barrier_layer",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "屏障所属阶段，不能承认旧层ack"
          },
          {
            "name": "o_core_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "原算术核组valid"
          },
          {
            "name": "i_core_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原算术核输入组ready"
          },
          {
            "name": "o_core_first",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "原接口首组语义不变"
          },
          {
            "name": "o_core_last",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "原接口末组语义不变"
          },
          {
            "name": "o_core_input_mask",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "八输入尾mask"
          },
          {
            "name": "o_core_activation",
            "direction": "output",
            "width": 64,
            "role": "native",
            "description": "原64位INT8输入"
          },
          {
            "name": "o_core_weight",
            "direction": "output",
            "width": 192,
            "role": "native",
            "description": "原192位权重"
          },
          {
            "name": "o_core_bias",
            "direction": "output",
            "width": 96,
            "role": "native",
            "description": "first只加一次的三路bias"
          },
          {
            "name": "o_core_output_mask",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "图边界或三空间点尾路"
          },
          {
            "name": "o_core_tags",
            "direction": "output",
            "width": 48,
            "role": "native",
            "description": "单任务lane身份0/1/2"
          },
          {
            "name": "o_core_addresses",
            "direction": "output",
            "width": 96,
            "role": "native",
            "description": "三路完整真实字节地址"
          },
          {
            "name": "o_core_pre_multiplier",
            "direction": "output",
            "width": 96,
            "role": "native",
            "description": "三路原pre乘数"
          },
          {
            "name": "o_core_pre_shift",
            "direction": "output",
            "width": 18,
            "role": "native",
            "description": "三路六位pre移位"
          },
          {
            "name": "o_core_post_multiplier",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "当前层共享post乘数"
          },
          {
            "name": "o_core_post_shift",
            "direction": "output",
            "width": 6,
            "role": "native",
            "description": "当前层共享post移位"
          },
          {
            "name": "o_core_residual",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "两个PW阶段才做旁路融合"
          },
          {
            "name": "o_core_bypass",
            "direction": "output",
            "width": 24,
            "role": "native",
            "description": "对应三输出的真实旁路"
          },
          {
            "name": "i_core_output_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原五级写回发布结果"
          },
          {
            "name": "o_core_output_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "合法结果与外部写原子接受"
          },
          {
            "name": "i_core_output_tag",
            "direction": "input",
            "width": 16,
            "role": "native",
            "description": "原核返回任务lane"
          },
          {
            "name": "i_core_output_address",
            "direction": "input",
            "width": 32,
            "role": "native",
            "description": "原核返回完整地址"
          },
          {
            "name": "i_core_output_data",
            "direction": "input",
            "width": 8,
            "role": "native",
            "description": "原核sat8输出"
          },
          {
            "name": "i_core_output_sum",
            "direction": "input",
            "width": 9,
            "role": "native",
            "description": "原核signed9和"
          },
          {
            "name": "i_core_fault",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原核错误，不修改其故障语义"
          }
        ]
      },
      "behavior": [
        "五阶段固定图调度：DW0、PW0加残差、DW1、PW1加残差、PW融合",
        "第一残差6x6真实邻域支持第二残差4x4输出；仅全幅图像外padding",
        "无私有算术实例，valid/ready组与现算术核保持兼容",
        "末次真实写、注册task_done、层可见性屏障是不同事件",
        "共同复位取消所有参与服务；取消故障不释放存储，不能用于独立CNN取消"
      ],
      "constraints": [
        "逻辑字节服务/参数端口为外围提案，未接真实DDR或ROM reader",
        "未修改共享算术核接口、II、数值或生产工程；非部署交付"
      ],
      "corner_cases": [
        "全幅四边及尾输入/输出lane",
        "组间参数漂移、错地址/错tag/重复写拒绝",
        "参数、读、写背压稳定",
        "共同复位后重新装表",
        "层屏障错身份拒绝"
      ],
      "verification_cases": [
        "同包acc/pre/SiLU/post/sum/output/address逐项比较",
        "四角四边内部与连续不同tile",
        "各阶段复位及协议负例",
        "检查器故意错误期望负例"
      ],
      "timing_diagrams": [
        {
          "id": "retire",
          "title": "末次真实写与阶段可见性",
          "scenario": "barrier",
          "description": "竖线省略其它任务和算术延迟；屏障等待没有固定拍数保证",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p..|......."
              },
              {
                "name": "last_write_accept",
                "wave": "010|......."
              },
              {
                "name": "registered_task_done",
                "wave": "001|0......"
              },
              {
                "name": "barrier_valid",
                "wave": "0..|0111100"
              },
              {
                "name": "barrier_ready_visible",
                "wave": "0..|0000100"
              },
              {
                "name": "next_layer_or_done",
                "wave": "0..|0000010"
              }
            ]
          }
        }
      ]
    }
  ]
}
