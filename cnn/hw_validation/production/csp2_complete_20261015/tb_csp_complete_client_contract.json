{
  "name": "csp_complete_client",
  "modules": [
    {
      "name": "tb_csp_complete_client",
      "rtl_path": "tests/tb_csp_complete_client.v",
      "clock": {
        "name": "clk",
        "edge": "posedge",
        "frequency_mhz": 100
      },
      "reset": {
        "name": "rstn",
        "active": "low",
        "synchronous": false
      },
      "interfaces": {
        "ports": [
          {
            "name": "o_test_complete",
            "direction": "output",
            "width": 1,
            "role": "verification_completion",
            "description": "所有当前场景检查完成后置位"
          }
        ]
      },
      "behavior": [
        "五阶段固定图调度：DW0、PW0加残差、DW1、PW1加残差、PW融合",
        "第一残差6x6真实邻域支持第二残差4x4输出；仅全幅图像外padding",
        "无私有算术实例，valid/ready组与现算术核保持兼容",
        "末次真实写、注册task_done、层可见性屏障是不同事件",
        "共同复位取消所有参与服务；取消故障不释放存储，不能用于独立CNN取消"
      ],
      "constraints": [
        "逻辑字节服务/参数端口为外围提案，未接真实DDR或ROM reader",
        "未修改共享算术核接口、II、数值或生产工程；非部署交付"
      ],
      "corner_cases": [
        "全幅四边及尾输入/输出lane",
        "组间参数漂移、错地址/错tag/重复写拒绝",
        "参数、读、写背压稳定",
        "共同复位后重新装表",
        "层屏障错身份拒绝"
      ],
      "verification_cases": [
        "同包acc/pre/SiLU/post/sum/output/address逐项比较",
        "四角四边内部与连续不同tile",
        "各阶段复位及协议负例",
        "检查器故意错误期望负例"
      ],
      "timing_diagrams": [
        {
          "id": "retire",
          "title": "末次真实写与阶段可见性",
          "scenario": "barrier",
          "description": "竖线省略其它任务和算术延迟；屏障等待没有固定拍数保证",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p..|......."
              },
              {
                "name": "last_write_accept",
                "wave": "010|......."
              },
              {
                "name": "registered_task_done",
                "wave": "001|0......"
              },
              {
                "name": "barrier_valid",
                "wave": "0..|0111100"
              },
              {
                "name": "barrier_ready_visible",
                "wave": "0..|0000100"
              },
              {
                "name": "next_layer_or_done",
                "wave": "0..|0000010"
              }
            ]
          }
        }
      ]
    }
  ]
}
