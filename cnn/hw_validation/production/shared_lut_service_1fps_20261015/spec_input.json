{
  "feature": "road_shared_lut_service",
  "name": "road_shared_lut_service",
  "rtl_path": "rtl/road_shared_lut_service.v",
  "interfaces": {
    "ports": [
      {
        "name": "i_clk",
        "direction": "input",
        "width": 1,
        "role": "clk",
        "clock_domain": "i_clk",
        "description": "统一100MHz上升沿时钟"
      },
      {
        "name": "i_rstn",
        "direction": "input",
        "width": 1,
        "role": "rstn",
        "clock_domain": "i_clk",
        "description": "共同低有效异步复位，本地两级同步释放"
      },
      {
        "name": "i_cancel",
        "direction": "input",
        "width": 1,
        "role": "cancel",
        "clock_domain": "i_clk",
        "description": "取消当前查表，已接受的ROM读必须排空后再接新任务"
      },
      {
        "name": "i_lut_req_valid",
        "direction": "input",
        "width": 1,
        "role": "lut_req_valid",
        "clock_domain": "i_clk",
        "description": "查表请求有效，等待ready时所有请求字段保持"
      },
      {
        "name": "i_lut_req_kind",
        "direction": "input",
        "width": 1,
        "role": "lut_req_kind",
        "clock_domain": "i_clk",
        "description": "0为sigmoid，1为exp"
      },
      {
        "name": "i_lut_req_address",
        "direction": "input",
        "width": 10,
        "role": "lut_req_address",
        "clock_domain": "i_clk",
        "description": "表内索引；exp只允许0至255"
      },
      {
        "name": "i_lut_req_tag",
        "direction": "input",
        "width": 16,
        "role": "lut_req_tag",
        "clock_domain": "i_clk",
        "description": "16位请求标签，响应原样回显"
      },
      {
        "name": "i_lut_req_frame_token",
        "direction": "input",
        "width": 32,
        "role": "lut_req_frame_token",
        "clock_domain": "i_clk",
        "description": "请求源帧任务标识，响应回显"
      },
      {
        "name": "i_lut_req_model_id",
        "direction": "input",
        "width": 32,
        "role": "lut_req_model_id",
        "clock_domain": "i_clk",
        "description": "绑定完整模型payload的32位模型标识"
      },
      {
        "name": "i_lut_rsp_ready",
        "direction": "input",
        "width": 1,
        "role": "lut_rsp_ready",
        "clock_domain": "i_clk",
        "description": "本拍允许消费一次完整查表响应"
      },
      {
        "name": "i_rom_request_ready",
        "direction": "input",
        "width": 1,
        "role": "rom_request_ready",
        "clock_domain": "i_clk",
        "description": "现有reader允许锁定一个13位物理词地址"
      },
      {
        "name": "i_rom_response_valid",
        "direction": "input",
        "width": 1,
        "role": "rom_response_valid",
        "clock_domain": "i_clk",
        "description": "reader完整160位响应有效，不携带标签"
      },
      {
        "name": "i_rom_response_data",
        "direction": "input",
        "width": 160,
        "role": "rom_response_data",
        "clock_domain": "i_clk",
        "description": "低8位对应物理词第0字节的160位载荷"
      },
      {
        "name": "i_rom_fault",
        "direction": "input",
        "width": 1,
        "role": "rom_fault",
        "clock_domain": "i_clk",
        "description": "reader粘滞故障，只由共同复位清除"
      },
      {
        "name": "o_lut_req_ready",
        "direction": "output",
        "width": 1,
        "role": "lut_req_ready",
        "clock_domain": "i_clk",
        "description": "空闲且无旧ROM在途时允许一次查表传输"
      },
      {
        "name": "o_lut_rsp_valid",
        "direction": "output",
        "width": 1,
        "role": "lut_rsp_valid",
        "clock_domain": "i_clk",
        "description": "查表完整响应有效，等ready时身份与数据保持"
      },
      {
        "name": "o_lut_rsp_kind",
        "direction": "output",
        "width": 1,
        "role": "lut_rsp_kind",
        "clock_domain": "i_clk",
        "description": "回显已接受请求的表类别"
      },
      {
        "name": "o_lut_rsp_address",
        "direction": "output",
        "width": 10,
        "role": "lut_rsp_address",
        "clock_domain": "i_clk",
        "description": "回显已接受请求的原索引"
      },
      {
        "name": "o_lut_rsp_tag",
        "direction": "output",
        "width": 16,
        "role": "lut_rsp_tag",
        "clock_domain": "i_clk",
        "description": "回显已接受请求的16位标签"
      },
      {
        "name": "o_lut_rsp_frame_token",
        "direction": "output",
        "width": 32,
        "role": "lut_rsp_frame_token",
        "clock_domain": "i_clk",
        "description": "回显源帧标识，禁止旧响应串入新任务"
      },
      {
        "name": "o_lut_rsp_model_id",
        "direction": "output",
        "width": 32,
        "role": "lut_rsp_model_id",
        "clock_domain": "i_clk",
        "description": "回显请求模型标识"
      },
      {
        "name": "o_lut_rsp_data",
        "direction": "output",
        "width": 16,
        "role": "lut_rsp_data",
        "clock_domain": "i_clk",
        "description": "从冻结小端ROM字节提取的UINT16值"
      },
      {
        "name": "o_lut_rsp_error",
        "direction": "output",
        "width": 1,
        "role": "lut_rsp_error",
        "clock_domain": "i_clk",
        "description": "范围/模型/ROM错误，错误数据为零"
      },
      {
        "name": "o_rom_request_valid",
        "direction": "output",
        "width": 1,
        "role": "rom_request_valid",
        "clock_domain": "i_clk",
        "description": "唯一ROM读口请求有效，等待ready时词地址保持"
      },
      {
        "name": "o_rom_request_addr",
        "direction": "output",
        "width": 13,
        "role": "rom_request_addr",
        "clock_domain": "i_clk",
        "description": "20字节物理词号，合法0至7167"
      },
      {
        "name": "o_rom_response_ready",
        "direction": "output",
        "width": 1,
        "role": "rom_response_ready",
        "clock_domain": "i_clk",
        "description": "消费当前ROM读响应；取消排空也必须握手"
      },
      {
        "name": "o_fault",
        "direction": "output",
        "width": 1,
        "role": "fault",
        "clock_domain": "i_clk",
        "description": "本组件故障状态，不得发布为成功表"
      }
    ]
  },
  "clock": {
    "name": "i_clk",
    "frequency_hz": 100000000
  },
  "reset": {
    "name": "i_rstn",
    "assert": "async_low",
    "release": "local_sync_two_flops_or_owner_gating"
  },
  "parameters": {
    "C_SIGMOID_BYTE_OFFSET": 137962,
    "C_EXP_BYTE_OFFSET": 140010
  },
  "behavior": [
    "IDLE接收并锁定所有身份；模型/exp范围错误返回error且不读ROM。18拍除20，注册word和lane。",
    "单个ROM请求等待ready；返回低字节在高lane19时请求相邻词并拼接第二字节，否则单读。",
    "LUT响应身份/数据/error保持至消费；不接第二条查询；ROM fault粘滞到共同复位。",
    "cancel立即屏蔽客户端，已接受的无标签ROM读进入DRAIN，握手丢弃旧返回后才ready；不复位reader。"
  ],
  "constraints": [
    "Verilog-2001；一个未决事务；ready/valid握手；无TD/物理时序签核",
    "不改变冻结算术核/数值，不复制公共存储"
  ],
  "corner_cases": [
    "复位、取消、背压、非法身份和边界地址；取消不能当成无标签外设已排空"
  ],
  "verification_cases": [
    "all1024sigmoid",
    "all256exp",
    "dynamic identities",
    "byte/lane/word boundaries",
    "odd relocation crossword",
    "request bubbles",
    "ROM request stalls",
    "delayed responses",
    "LUT response long hold",
    "cancel before ROM acceptance",
    "cancel while ROM pending and late response then restart",
    "cancel between crossword reads",
    "common reset during wait/response",
    "wrong model",
    "exp index256 and1023",
    "ROM fault"
  ],
  "timing_diagrams": [
    {
      "id": "ownership",
      "title": "请求所有权与停顿",
      "scenario": "request-hold-response",
      "description": "协议示意：省略内部变长计算，用空白间隔表示；不是固定总时延。仅valid与ready同拍消费。",
      "wavejson": {
        "signal": [
          {
            "name": "i_clk",
            "wave": "p..........."
          },
          {
            "name": "lut_req_valid",
            "wave": "01..0......."
          },
          {
            "name": "lut_req_ready",
            "wave": "0..10......."
          },
          {
            "name": "rom_req_valid",
            "wave": "0....1.0...."
          },
          {
            "name": "rom_req_ready",
            "wave": "0......10..."
          },
          {
            "name": "rom_rsp_valid",
            "wave": "0.......10.."
          },
          {
            "name": "lut_rsp_valid",
            "wave": "0........1.0"
          },
          {
            "name": "lut_rsp_ready",
            "wave": "0.........10"
          }
        ]
      }
    }
  ]
}
