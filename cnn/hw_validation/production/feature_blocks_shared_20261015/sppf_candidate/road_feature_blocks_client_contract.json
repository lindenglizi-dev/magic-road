{
  "name": "feature_sppf",
  "modules": [
    {
      "name": "road_feature_blocks_client",
      "rtl_path": "rtl/road_feature_blocks_client.v",
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_mhz": 100
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "synchronous": false
      },
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "与算术owner同域100MHz"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "共同异步复位，服务同时撤销旧响应"
          },
          {
            "name": "i_block_id",
            "direction": "input",
            "width": 4,
            "role": "native",
            "description": "仅start握手锁存的固定块编号"
          },
          {
            "name": "o_block_id",
            "direction": "output",
            "width": 4,
            "role": "native",
            "description": "当前任务身份直到下一次start保持"
          },
          {
            "name": "i_start",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "ready时启动一次完整固定图任务"
          },
          {
            "name": "i_cancel",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "取消后故障占有至共同复位"
          },
          {
            "name": "i_table_loaded",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "外部owner已装入同包SiLU表"
          },
          {
            "name": "o_start_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "空闲、无故障且表有效"
          },
          {
            "name": "o_busy",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "包含完成拍和故障占有"
          },
          {
            "name": "o_done",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "末阶段可见性确认后单拍完成"
          },
          {
            "name": "o_fault",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "信任边界错误粘滞指示"
          },
          {
            "name": "o_layer",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "当前块内阶段编号"
          },
          {
            "name": "o_tile_y",
            "direction": "output",
            "width": 7,
            "role": "native",
            "description": "当前四行块起点诊断"
          },
          {
            "name": "o_tile_x",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "当前四列块起点诊断"
          },
          {
            "name": "o_parameter_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前参数分片请求有效"
          },
          {
            "name": "o_parameter_channel",
            "direction": "output",
            "width": 7,
            "role": "native",
            "description": "DW通道或PW输出三通道起点"
          },
          {
            "name": "o_parameter_group",
            "direction": "output",
            "width": 5,
            "role": "native",
            "description": "八输入归约组编号"
          },
          {
            "name": "o_parameter_window",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "DW窗口并集宽度，PW为零"
          },
          {
            "name": "i_parameter_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "参数请求被服务接受"
          },
          {
            "name": "i_parameter_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "参数响应保持至ready"
          },
          {
            "name": "o_parameter_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "只消费当前未完成请求"
          },
          {
            "name": "i_parameter_response_block_id",
            "direction": "input",
            "width": 4,
            "role": "native",
            "description": "响应必须属于当前锁存块"
          },
          {
            "name": "i_parameter_response_layer",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "参数响应阶段身份"
          },
          {
            "name": "i_parameter_response_channel",
            "direction": "input",
            "width": 7,
            "role": "native",
            "description": "参数响应输出通道身份"
          },
          {
            "name": "i_parameter_response_group",
            "direction": "input",
            "width": 5,
            "role": "native",
            "description": "参数响应归约组身份"
          },
          {
            "name": "i_parameter_response_window",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "参数响应DW窗口形态"
          },
          {
            "name": "i_parameter_weight",
            "direction": "input",
            "width": 192,
            "role": "native",
            "description": "三路八输入权重"
          },
          {
            "name": "i_parameter_data",
            "direction": "input",
            "width": 248,
            "role": "native",
            "description": "bias及动态量化字段"
          },
          {
            "name": "i_parameter_error",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "参数服务显式错误"
          },
          {
            "name": "o_read_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "单个16字节行请求有效"
          },
          {
            "name": "o_read_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "十六字节对齐逻辑地址"
          },
          {
            "name": "i_read_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "行请求被内存服务接受"
          },
          {
            "name": "i_read_response_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "行响应保持至ready"
          },
          {
            "name": "o_read_response_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "只消费当前未完成行请求"
          },
          {
            "name": "i_read_response_address",
            "direction": "input",
            "width": 32,
            "role": "native",
            "description": "必须匹配请求的对齐地址"
          },
          {
            "name": "i_read_response_data",
            "direction": "input",
            "width": 128,
            "role": "native",
            "description": "低字节对应地址偏移零"
          },
          {
            "name": "i_read_error",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "内存服务显式读错误"
          },
          {
            "name": "o_write_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "合法核结果写请求"
          },
          {
            "name": "o_write_address",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "完整冻结图字节地址"
          },
          {
            "name": "o_write_data",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "最终饱和INT8结果"
          },
          {
            "name": "o_write_sum",
            "direction": "output",
            "width": 9,
            "role": "native",
            "description": "饱和前signed9残差和"
          },
          {
            "name": "i_write_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "外部写服务接受"
          },
          {
            "name": "o_barrier_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前整层全部写接受后的屏障"
          },
          {
            "name": "i_barrier_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "此层此前写已经可读"
          },
          {
            "name": "i_barrier_block_id",
            "direction": "input",
            "width": 4,
            "role": "native",
            "description": "屏障必须属于当前锁存块"
          },
          {
            "name": "i_barrier_layer",
            "direction": "input",
            "width": 3,
            "role": "native",
            "description": "屏障确认所属阶段"
          },
          {
            "name": "o_core_valid",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "原算术核输入组有效"
          },
          {
            "name": "i_core_ready",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原算术核输入组接受"
          },
          {
            "name": "o_core_first",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前任务首归约组"
          },
          {
            "name": "o_core_last",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "当前任务末归约组"
          },
          {
            "name": "o_core_input_mask",
            "direction": "output",
            "width": 8,
            "role": "native",
            "description": "当前八输入有效掩码"
          },
          {
            "name": "o_core_activation",
            "direction": "output",
            "width": 64,
            "role": "native",
            "description": "串行拼装的八个INT8输入"
          },
          {
            "name": "o_core_weight",
            "direction": "output",
            "width": 192,
            "role": "native",
            "description": "当前归约组驻留参数"
          },
          {
            "name": "o_core_bias",
            "direction": "output",
            "width": 96,
            "role": "native",
            "description": "三路首组偏置"
          },
          {
            "name": "o_core_output_mask",
            "direction": "output",
            "width": 3,
            "role": "native",
            "description": "DW行尾任务只启用lane零"
          },
          {
            "name": "o_core_tags",
            "direction": "output",
            "width": 48,
            "role": "native",
            "description": "固定三路任务身份"
          },
          {
            "name": "o_core_addresses",
            "direction": "output",
            "width": 96,
            "role": "native",
            "description": "三路完整写地址"
          },
          {
            "name": "o_core_pre_multiplier",
            "direction": "output",
            "width": 96,
            "role": "native",
            "description": "三路动态前乘数"
          },
          {
            "name": "o_core_pre_shift",
            "direction": "output",
            "width": 18,
            "role": "native",
            "description": "三路六位前移位"
          },
          {
            "name": "o_core_post_multiplier",
            "direction": "output",
            "width": 32,
            "role": "native",
            "description": "当前层共享后乘数"
          },
          {
            "name": "o_core_post_shift",
            "direction": "output",
            "width": 6,
            "role": "native",
            "description": "当前层共享后移位"
          },
          {
            "name": "o_core_residual",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "PW残差阶段使能"
          },
          {
            "name": "o_core_bypass",
            "direction": "output",
            "width": 24,
            "role": "native",
            "description": "三路真实旁路值"
          },
          {
            "name": "i_core_output_valid",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原五级写回结果有效"
          },
          {
            "name": "o_core_output_ready",
            "direction": "output",
            "width": 1,
            "role": "native",
            "description": "核结果和外部写原子接受"
          },
          {
            "name": "i_core_output_tag",
            "direction": "input",
            "width": 16,
            "role": "native",
            "description": "原核返回任务lane"
          },
          {
            "name": "i_core_output_address",
            "direction": "input",
            "width": 32,
            "role": "native",
            "description": "原核返回完整地址"
          },
          {
            "name": "i_core_output_data",
            "direction": "input",
            "width": 8,
            "role": "native",
            "description": "原核返回sat8数据"
          },
          {
            "name": "i_core_output_sum",
            "direction": "input",
            "width": 9,
            "role": "native",
            "description": "原核返回signed9和"
          },
          {
            "name": "i_core_fault",
            "direction": "input",
            "width": 1,
            "role": "native",
            "description": "原核错误保持原语义"
          }
        ]
      },
      "behavior": [
        "固定块2/3/4保留，新增5=SPPF；start握手锁存身份，busy不切换",
        "一个FSM、3072B工作缓存、24项权重bank、唯一外部算术owner",
        "SPPF squeeze PW -> 三次signed INT8 pool5x5 pad=-128 -> 四路concat -> out PW",
        "pool单缓存口逐样本比较并持有写载荷至ready，不使用MAC/SiLU，不写y18/y19",
        "concat为四物理张量读视图，不复制实体concat缓存；每层写可见性后推进",
        "参数/屏障块归属及原核数值/II/复位保持，真实DDR尚未接入"
      ],
      "constraints": [
        "固定图非任意引擎，核心端口/II/数值/复位不改",
        "CSP2 Cin12尾mask0f，CSP4物理尾tile仅两行有效，禁止y18/y19写",
        "同实例顺序运行不等于down3/down4已接入或连续CNN",
        "4ERAM为容量组织目标，未实际映射/综合/物理时序",
        "100M是整机1FPS目标，不是本组件已证明整机帧率"
      ],
      "corner_cases": [
        "忙时block/start扰动，跨块缓存完全覆盖，随机背压保持payload",
        "非法块、错误参数block、错误屏障block与真实acc负例",
        "共同复位、SiLU重装、CSP4尾行与CSP2尾通道",
        "池化负数/极值及逻辑pad=-128区别于物理尾padding0",
        "池化长写背压及共同复位"
      ],
      "verification_cases": [
        "同实例真实CSP4写回结果供SPPF读取，全部conv和pool逐项对拍",
        "正常、随机、pool中共同复位后完整重跑、长写反压、实际pool检查器负例",
        "新增客户端对原2->3->4全幅回归"
      ],
      "timing_diagrams": [
        {
          "id": "select",
          "title": "固定块只在启动握手锁存",
          "scenario": "selection",
          "description": "中间省略全幅计算；done仍busy，返回idle后才接受下一块",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p..|......"
              },
              {
                "name": "start_accept",
                "wave": "010|000010"
              },
              {
                "name": "input_block",
                "wave": "==.|=...=.",
                "data": [
                  "2",
                  "3",
                  "15",
                  "3"
                ]
              },
              {
                "name": "locked_block",
                "wave": ".=.|....=.",
                "data": [
                  "2",
                  "3"
                ]
              },
              {
                "name": "busy",
                "wave": "0.1|110.1."
              },
              {
                "name": "done",
                "wave": "0..|010..."
              },
              {
                "name": "start_ready",
                "wave": "1.0|001.0."
              }
            ]
          }
        }
      ]
    }
  ]
}
