{
  "feature": "road_rom_two_client_top",
  "name": "road_rom_two_client_top",
  "rtl_path": "rtl/road_rom_two_client_top.v",
  "interfaces": {
    "ports": [
      {
        "name": "i_clk",
        "direction": "input",
        "width": 1,
        "role": "clk",
        "clock_domain": "i_clk",
        "description": "统一100MHz上升沿时钟"
      },
      {
        "name": "i_rstn",
        "direction": "input",
        "width": 1,
        "role": "rstn",
        "clock_domain": "i_clk",
        "description": "共同低有效异步复位，本地两级同步释放"
      },
      {
        "name": "i_cancel",
        "direction": "input",
        "width": 1,
        "role": "cancel",
        "clock_domain": "i_clk",
        "description": "取消当前查表，已接受的ROM读必须排空后再接新任务"
      },
      {
        "name": "i_lut_req_valid",
        "direction": "input",
        "width": 1,
        "role": "lut_req_valid",
        "clock_domain": "i_clk",
        "description": "查表请求有效，等待ready时所有请求字段保持"
      },
      {
        "name": "i_lut_req_kind",
        "direction": "input",
        "width": 1,
        "role": "lut_req_kind",
        "clock_domain": "i_clk",
        "description": "0为sigmoid，1为exp"
      },
      {
        "name": "i_lut_req_address",
        "direction": "input",
        "width": 10,
        "role": "lut_req_address",
        "clock_domain": "i_clk",
        "description": "表内索引；exp只允许0至255"
      },
      {
        "name": "i_lut_req_tag",
        "direction": "input",
        "width": 16,
        "role": "lut_req_tag",
        "clock_domain": "i_clk",
        "description": "16位请求标签，响应原样回显"
      },
      {
        "name": "i_lut_req_frame_token",
        "direction": "input",
        "width": 32,
        "role": "lut_req_frame_token",
        "clock_domain": "i_clk",
        "description": "请求源帧任务标识，响应回显"
      },
      {
        "name": "i_lut_req_model_id",
        "direction": "input",
        "width": 32,
        "role": "lut_req_model_id",
        "clock_domain": "i_clk",
        "description": "绑定完整模型payload的32位模型标识"
      },
      {
        "name": "i_lut_rsp_ready",
        "direction": "input",
        "width": 1,
        "role": "lut_rsp_ready",
        "clock_domain": "i_clk",
        "description": "本拍允许消费一次完整查表响应"
      },
      {
        "name": "i_load_ready",
        "direction": "input",
        "width": 1,
        "role": "load_ready",
        "clock_domain": "i_clk",
        "description": "load_ready：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "i_table_ready",
        "direction": "input",
        "width": 1,
        "role": "table_ready",
        "clock_domain": "i_clk",
        "description": "table_ready：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_lut_req_ready",
        "direction": "output",
        "width": 1,
        "role": "lut_req_ready",
        "clock_domain": "i_clk",
        "description": "空闲且无旧ROM在途时允许一次查表传输"
      },
      {
        "name": "o_lut_rsp_valid",
        "direction": "output",
        "width": 1,
        "role": "lut_rsp_valid",
        "clock_domain": "i_clk",
        "description": "查表完整响应有效，等ready时身份与数据保持"
      },
      {
        "name": "o_lut_rsp_kind",
        "direction": "output",
        "width": 1,
        "role": "lut_rsp_kind",
        "clock_domain": "i_clk",
        "description": "回显已接受请求的表类别"
      },
      {
        "name": "o_lut_rsp_address",
        "direction": "output",
        "width": 10,
        "role": "lut_rsp_address",
        "clock_domain": "i_clk",
        "description": "回显已接受请求的原索引"
      },
      {
        "name": "o_lut_rsp_tag",
        "direction": "output",
        "width": 16,
        "role": "lut_rsp_tag",
        "clock_domain": "i_clk",
        "description": "回显已接受请求的16位标签"
      },
      {
        "name": "o_lut_rsp_frame_token",
        "direction": "output",
        "width": 32,
        "role": "lut_rsp_frame_token",
        "clock_domain": "i_clk",
        "description": "回显源帧标识，禁止旧响应串入新任务"
      },
      {
        "name": "o_lut_rsp_model_id",
        "direction": "output",
        "width": 32,
        "role": "lut_rsp_model_id",
        "clock_domain": "i_clk",
        "description": "回显请求模型标识"
      },
      {
        "name": "o_lut_rsp_data",
        "direction": "output",
        "width": 16,
        "role": "lut_rsp_data",
        "clock_domain": "i_clk",
        "description": "从冻结小端ROM字节提取的UINT16值"
      },
      {
        "name": "o_lut_rsp_error",
        "direction": "output",
        "width": 1,
        "role": "lut_rsp_error",
        "clock_domain": "i_clk",
        "description": "范围/模型/ROM错误，错误数据为零"
      },
      {
        "name": "o_fault",
        "direction": "output",
        "width": 1,
        "role": "fault",
        "clock_domain": "i_clk",
        "description": "本组件故障状态，不得发布为成功表"
      },
      {
        "name": "o_load_valid",
        "direction": "output",
        "width": 1,
        "role": "load_valid",
        "clock_domain": "i_clk",
        "description": "load_valid：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_load_kind",
        "direction": "output",
        "width": 3,
        "role": "load_kind",
        "clock_domain": "i_clk",
        "description": "load_kind：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_load_addr",
        "direction": "output",
        "width": 11,
        "role": "load_addr",
        "clock_domain": "i_clk",
        "description": "load_addr：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_load_data",
        "direction": "output",
        "width": 32,
        "role": "load_data",
        "clock_domain": "i_clk",
        "description": "load_data：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_table_valid",
        "direction": "output",
        "width": 1,
        "role": "table_valid",
        "clock_domain": "i_clk",
        "description": "table_valid：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_table_addr",
        "direction": "output",
        "width": 10,
        "role": "table_addr",
        "clock_domain": "i_clk",
        "description": "table_addr：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_table_data",
        "direction": "output",
        "width": 16,
        "role": "table_data",
        "clock_domain": "i_clk",
        "description": "table_data：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_prefetch_done",
        "direction": "output",
        "width": 1,
        "role": "prefetch_done",
        "clock_domain": "i_clk",
        "description": "prefetch_done：按requirements中对应事务/计数合同使用"
      },
      {
        "name": "o_prefetch_cycles",
        "direction": "output",
        "width": 32,
        "role": "prefetch_cycles",
        "clock_domain": "i_clk",
        "description": "prefetch_cycles：按requirements中对应事务/计数合同使用"
      }
    ]
  },
  "clock": {
    "name": "i_clk",
    "frequency_hz": 100000000
  },
  "reset": {
    "name": "i_rstn",
    "assert": "async_low",
    "release": "local_sync_two_flops_or_owner_gating"
  },
  "parameters": {},
  "behavior": [
    "原prefetch启动即顺序加载down2两层652项及1024SiLU；输出反压不改变已发参数。",
    "动态LUT服务与prefetch通过单事务仲裁访问唯一G10 reader；取消只进LUT服务，所有模块共同复位。",
    "prefetch无ROMfault输入，顶层全局fault必须阻断成功发布并共同复位；不是67层加载器。"
  ],
  "constraints": [
    "Verilog-2001；一个未决事务；ready/valid握手；无TD/物理时序签核",
    "不改变冻结算术核/数值，不复制公共存储"
  ],
  "corner_cases": [
    "复位、取消、背压、非法身份和边界地址；取消不能当成无标签外设已排空"
  ],
  "verification_cases": [
    "11数值向量、protocol、phase_reset，逐项DECODED160对拍"
  ],
  "timing_diagrams": [
    {
      "id": "ownership",
      "title": "请求所有权与停顿",
      "scenario": "request-hold-response",
      "description": "协议示意：省略内部变长计算，用空白间隔表示；不是固定总时延。仅valid与ready同拍消费。",
      "wavejson": {
        "signal": [
          {
            "name": "i_clk",
            "wave": "p........."
          },
          {
            "name": "param_req_valid",
            "wave": "01......0."
          },
          {
            "name": "lut_req_valid",
            "wave": "01......0."
          },
          {
            "name": "client_accept",
            "wave": "010.....10"
          },
          {
            "name": "owner",
            "wave": "=.......=.",
            "data": [
              "PARAM",
              "LUT"
            ]
          },
          {
            "name": "rom_req_valid",
            "wave": "0.10.....1"
          },
          {
            "name": "owner_rsp_valid",
            "wave": "0....1..0."
          },
          {
            "name": "owner_rsp_ready",
            "wave": "0......10."
          }
        ]
      }
    }
  ]
}
